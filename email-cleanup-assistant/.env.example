# Server Configuration
PORT=3000
HOST=localhost

# OpenAI API (optional - will use rule-based responses if not set)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Automation Settings
HEADLESS=false
SLOW_MO=100
TIMEOUT=30000

# Security (optional)
ENCRYPT_CREDENTIALS=false
MASTER_PASSWORD=

# Development
DEBUG=false
LOGGING=true
